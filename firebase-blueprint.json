        "purchasedItemKeys": { "type": "array" },
        "referralRewardGranted": { "type": "boolean" }
      },
      "required": ["orderNumber", "customer", "items", "total", "paymentMethod", "status"]
    },
    "Coupon": {
      "title": "Coupon",
