{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product with retail and wholesale pricing, inventory, and categorization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "wholesalePrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "profitMargin": { "type": "number" },
        "images": { "type": "array" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "stock": { "type": "number" },
        "minimumStock": { "type": "number" },
        "maximumStock": { "type": "number" },
        "stockStatus": { "type": "string" },
        "supplier": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierSku": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "salesCount": { "type": "number" },
        "unitsSold": { "type": "number" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["name", "salePrice", "categoryId", "stock"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Wholesale product suppliers and vendor contact directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "notes": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "active"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Inventory ledger movement auditing sales, restocks, adjustments, and returns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productSku": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousStock": { "type": "number" },
        "newStock": { "type": "number" },
        "reason": { "type": "string" },
        "orderId": { "type": "string" },
        "adminId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "type", "quantity", "previousStock", "newStock", "reason"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Administrative alerts for low stock, new orders, payments, and preparation tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "priority": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "title", "message", "priority", "read"]
    },
    "AdminAction": {
      "title": "AdminAction",
      "description": "Audit trail log of all administrative changes in the VONDRO platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "entityId": { "type": "string" },
        "previousValue": { "type": "string" },
        "newValue": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["adminEmail", "action", "entity", "entityId"]
    },
    "OrderReturn": {
      "title": "OrderReturn",
      "description": "Customer return records and inventory reimbursement registry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "reason": { "type": "string" },
        "refundStock": { "type": "boolean" },
        "status": { "type": "string" },
        "registeredBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderId", "productId", "quantity", "reason"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category for store organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "icon": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "number" },
        "image": { "type": "string" },
        "productCount": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingZoneId": { "type": "string" },
