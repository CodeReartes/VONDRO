      "title": "DailyStockAudit",
      "description": "Daily automated audit analyzing new products, depleted out-of-stock items, and inventory changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "timestamp": { "type": "string" },
        "executedBy": { "type": "string" },
        "totalProductsChecked": { "type": "number" },
        "newProductsCount": { "type": "number" },
        "outOfStockCount": { "type": "number" },
        "stockChangesCount": { "type": "number" },
        "criticalLowStockCount": { "type": "number" },
        "summaryNote": { "type": "string" },
        "status": { "type": "string" }
