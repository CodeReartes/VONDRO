  "firestore": {
    "/dailyStockAudits/{auditId}": {
      "schema": "DailyStockAudit",
      "description": "Daily stock and catalog analysis audit records and snapshots"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of store products"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Collection of wholesale vendors and suppliers"
    },
    "/stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Audit ledger of stock entries, sales, adjustments, and returns"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System alerts and notifications for operations"
    },
    "/adminActions/{actionId}": {
      "schema": "AdminAction",
      "description": "Administrative actions audit trail"
    },
    "/returns/{returnId}": {
      "schema": "OrderReturn",
      "description": "Customer returns and stock re-entry"
    },
    "/couriers/{courierId}": {
      "schema": "Courier",
      "description": "Couriers and delivery personnel"
    },
    "/logisticsProviders/{providerId}": {
      "schema": "LogisticsProvider",
      "description": "Logistics companies and external providers"
    },
    "/shippingExpenses/{expenseId}": {
      "schema": "ShippingExpense",
      "description": "Shipping and dispatch expenses"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of store categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer purchase orders"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Collection of promotional discount coupons"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store configuration and operational parameters"
    },
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Registered user accounts and saved preferences"
    },
    "/assistantConversations/{conversationId}": {
      "schema": "AssistantConversation",
      "description": "Multichannel customer support chat sessions (Web, App, WhatsApp, Admin)"
    },
    "/assistantMessages/{messageId}": {
      "schema": "AssistantMessage",
      "description": "Messages exchanged in assistant conversations"
    },
    "/supportTickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer support tickets for claims, damages, returns and cancellations"
    },
    "/faqs/{faqId}": {
      "schema": "FAQItem",
      "description": "Frequently asked questions organized by category"
    },
    "/unresolvedQueries/{queryId}": {
      "schema": "UnresolvedQuery",
      "description": "User queries that were not resolved by AI or escalated to humans"
    }
  }
}
