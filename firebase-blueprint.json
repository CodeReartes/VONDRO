        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "channel", "status"]
    },
    "AssistantMessage": {
      "title": "AssistantMessage",
      "description": "Single message inside an assistant chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
