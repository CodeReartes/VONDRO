        "mercadoPago": { "type": "object" },
        "zones": { "type": "array" }
      },
      "required": ["storeName", "freeShippingThreshold"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Customer and administrator user profile",
      "type": "object",
      "properties": {
